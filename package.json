{
    "name": "5feelingmemory-fe",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "tsc -b && vite build",
        "build:dev": "tsc --noEmit && vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
        "preview": "vite preview",
        "clean": "rm -rf node_modules yarn.lock dist",
        "cy:dev": "cypress open",
        "cy": "cypress run",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "cap:sync": "tsc -b && vite build --mode app && cap sync",
        "cap:android": "npm run cap:sync && cap open android",
        "cap:run": "npm run cap:sync && cap run android",
        "apk:release": "bash scripts/build-release-apk.sh",
        "apk:publish": "bash scripts/publish-apk-release.sh"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/app": "^8.1.1",
        "@capacitor/browser": "^8.0.4",
