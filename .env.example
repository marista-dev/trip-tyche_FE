# ── API ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://api.triptyche.cloud
VITE_WEBSOCKET_URL=wss://api.triptyche.cloud/ws

# ── Google Maps ───────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=<Google Maps API 키>

# Vector mapId — Google Cloud Console > Maps > Map IDs 에서 생성
# Rendering Type: Vector  /  Tilt 및 Rotation 체크 필수
# 값이 비어 있으면 raster 맵으로 자동 fallback (3D 빌딩·틸트 비활성)
VITE_GOOGLE_MAPS_MAP_ID=
