# ── API ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://api.triptyche.cloud
VITE_WEBSOCKET_URL=wss://api.triptyche.cloud/ws

# ── Google Maps ───────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=<Google Maps API 키>

# Vector mapId — Google Cloud Console > Maps > Map IDs 에서 생성
# Rendering Type: Vector  /  Tilt 및 Rotation 체크 필수
# 값이 비어 있으면 raster 맵으로 자동 fallback (3D 빌딩·틸트 비활성)
VITE_GOOGLE_MAPS_MAP_ID=

# ── PostHog (사용자 행동 분석) ────────────────────────────────────
# 키가 비어 있으면 수집하지 않는다(no-op).
# ⚠️ Vite는 .env와 .env.local을 합쳐 읽는다. .env에 실제 키를 넣었다면 .env.local에도 `VITE_POSTHOG_KEY=`를
#    빈 값으로 명시해 덮어쓸 것. 줄이 아예 없으면 .env의 키가 그대로 적용돼 npm run dev가 운영 PostHog로 수집한다.
# 호스트는 PostHog 프로젝트의 리전에 맞춘다 (US: https://us.i.posthog.com, EU: https://eu.i.posthog.com)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
