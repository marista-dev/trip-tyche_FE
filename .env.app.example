# ── 앱(Capacitor) 빌드 전용 환경변수 ────────────────────────────────
# npx vite build --mode app 실행 시에만 로드된다 (.env.app.local > .env.app > .env.local > .env)

# ── Google Maps (앱 전용 키) ─────────────────────────────────────
# 웹 키와 별도로 발급한 앱 전용 키. 웹 키를 그대로 쓰지 않는다(APK에 웹 키가 박히는 것을 방지).
VITE_GOOGLE_MAPS_API_KEY=<앱 전용 Google Maps API 키>

# ── API ─────────────────────────────────────────────────────────
# ⚠️ 반드시 명시할 것. .env.local(개발용 localhost)이 .env(프로덕션)보다 우선순위가 높아,
#    여기서 고정하지 않으면 앱 빌드에 http://localhost:8080이 박힌다.
# 로컬 백엔드로 앱을 개발할 때는 .env.app.local에 에뮬레이터→호스트 주소(10.0.2.2)를 넣어 덮어쓴다.
VITE_API_BASE_URL=https://api.triptyche.cloud
VITE_WEBSOCKET_URL=wss://api.triptyche.cloud/ws

# ── PostHog (앱 빌드 전용) ───────────────────────────────────────
# 키가 비어 있으면 수집하지 않는다(no-op). 값은 .env.app.local 또는 빌드 환경에서 넣는다.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── S3 직접 전송 (앱 전용) ────────────────────────────────────────
# 'true'면 앱(Capacitor)에서 사진을 CapacitorHttp 대신 WebView의 원본 XHR로 S3에 직접 올린다.
# 파일을 base64로 바꾸지 않고 그대로 보내며, 업로드 진행률·정지 감지·취소가 동작한다. 웹 빌드에는 영향이 없다.
# 버킷 CORS가 origin https://localhost 의 PUT(Content-Type 헤더 포함)을 허용한다(2026-11-21 운영 버킷 확인).
# CORS 규칙이 바뀌어 허용이 빠지면 앱의 모든 업로드가 network 오류로 실패하므로 그때는 false로 되돌린다.
VITE_S3_DIRECT_UPLOAD=true
